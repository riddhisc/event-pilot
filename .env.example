# Copy to .env. This file contains safe demo defaults only.
# .env is gitignored. Never put a real secret in a VITE_ variable.

# Use the in-memory mock store locally and in the demo deployment.
VITE_USE_MOCK=true

# Mock account emails are stable demo identifiers; passwords belong only in .env.
VITE_MOCK_ADMIN_EMAIL=admin@eventbuddy.com
VITE_MOCK_ADMIN_PASSWORD=replace-with-demo-admin-password

VITE_MOCK_STAFF_EMAIL=staff@eventbuddy.com
VITE_MOCK_STAFF_PASSWORD=replace-with-demo-staff-password

VITE_MOCK_FDE_EMAIL=fde@eventbuddy.com
VITE_MOCK_FDE_PASSWORD=replace-with-demo-fde-password

# Optional public Supabase values; leave blank while mock mode is enabled.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Do not set this. Service-role keys belong in Supabase Edge Function secrets.
# VITE_SUPABASE_SERVICE_ROLE_KEY=
